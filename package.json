{
  "name": "routebench",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Local-first CLI for benchmarking and comparing LLM models behind an OpenAI-compatible router endpoint.",
  "bin": {
    "routebench": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/*.test.js",
    "demo": "node src/cli.js sample --output results/demo-results.json --report results/demo-report.md",
    "models": "node src/cli.js models",
    "bench": "node src/cli.js run",
    "bench:sample": "node src/cli.js sample",
    "report": "node src/cli.js report",
    "routing:export": "node src/cli.js routing-export",
    "promptfoo:config": "node src/cli.js promptfoo-config",
    "lint": "node scripts/check-syntax.js"
  },
  "files": [
    "src/",
    "benchmarks/",
    "scripts/",
    "routebench.config.example.json",
    "README.md"
  ],
  "keywords": [
    "llm",
    "benchmark",
    "router",
    "openai-compatible",
    "promptfoo"
  ],
  "license": "MIT",
  "devDependencies": {},
  "optionalDependencies": {
    "promptfoo": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
