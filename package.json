{
  "name": "routebench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RouteBench Phase 0 local-first LLM router benchmark proof-of-concept.",
  "bin": {
    "routebench": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/*.test.js",
